# =================================================================
# Say It Right - Environment Configuration Template
# =================================================================

# AI Provider: "groq" (Recommended for fast inference), "gemini", or "vertex"
AI_PROVIDER=groq

# Groq API Configuration (Get free API key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# (Optional) Google Gemini API Key from Google AI Studio
# GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Google Cloud Vertex AI configuration
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# Database URL for Prisma (SQLite by default, or Postgres for production)
DATABASE_URL="file:./dev.db"

# Node Environment
NODE_ENV=production
PORT=3000
